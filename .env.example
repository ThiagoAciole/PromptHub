# Docker Compose (.env)
POSTGRES_DB=prompthub
POSTGRES_USER=prompthub
POSTGRES_PASSWORD=change-me
API_PORT=3333
CORS_ORIGINS=
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=info

# API local (.env.local)
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
DATABASE_URL=postgres://prompthub:prompthub@localhost:5432/prompthub
